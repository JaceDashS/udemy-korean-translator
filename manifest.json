{
  "manifest_version": 3,
  "name": "Korean Translator for Udemy",
  "short_name": "Korean for Udemy",
  "version": "3.0.0",
  "key": "",
  "description": "Udemy 퀴즈와 영상 자막을 Chrome 내장 Translator API로 PC 안에서 한국어로 번역합니다. 아이콘을 누르면 개발자 용어 사전 편집기가 사이드 패널에 열립니다.",
  "minimum_chrome_version": "138",
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": [
    "https://api.jace-s.com/*",
    "https://www.udemy.com/*",
    "https://udemy.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": ["https://jace-s.com/*", "https://www.jace-s.com/*"]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "단어장 열기",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "editor/index.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.udemy.com/*", "https://udemy.com/*"],
      "js": ["dictionary-bridge.js"],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.udemy.com/*",
        "https://udemy.com/*"
      ],
      "js": [
        "dictionary-terms.js",
        "dictionary.js",
        "translator.js",
        "content.js",
        "caption.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
